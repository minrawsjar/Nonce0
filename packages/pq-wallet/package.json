{
  "name": "@opaque/pq-wallet",
  "version": "1.0.0-review",
  "private": true,
  "type": "module",
  "description": "Opaque V1 \u2014 PQ wallet (\u00a75): FORS+C few-time signatures, the \u00a75.3 digest, and PQKeyRegistry state. Manan, S1.",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/indexeddb-store.ts"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/dev.ts",
    "build:demo": "node scripts/dev.ts --build",
    "test:account": "cd ../../contracts && PQ_ACCOUNT_TESTS=true forge test --ffi --match-contract OpaquePqAccountTest",
    "test:account-integration": "PQ_ACCOUNT_INTEGRATION=1 node --test --test-isolation=none test/account-integration.test.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@opaque/protocol-types": "file:../protocol-types",
    "viem": "2.56.3"
  },
  "devDependencies": {
    "@account-abstraction/contracts": "0.7.0",
    "@openzeppelin/contracts": "5.0.2",
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2"
  }
}
