{
  "manifest_version": 3,
  "name": "opaque",
  "version": "0.3.0",
  "description": "Private USDC payments on Arc: a post-quantum account, ring-signed notes, and a relay mesh.",

  "action": {
    "default_title": "Open opaque"
  },

  "side_panel": {
    "default_path": "app.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },

  "permissions": ["sidePanel"],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
