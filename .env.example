# nonce0 — every endpoint and secret this repo reads. Copy to .env; .env is gitignored.
# Nothing here is required for `npx nonce0 scan .` — the scanner works with no config.

# --- The Graph (step 1) -------------------------------------------------------
# Subgraph Studio query URL. When unset, the exposure oracle uses the RPC nonce
# path only, which is the fallback described in docs/sponsor-plan.md §4.1.
# The Studio gateway embeds the API key in the URL path, which is exactly why
# this lives in an env var and never in a file shipped inside the npm tarball.
NONCE0_SUBGRAPH_URL=
GRAPH_API_KEY=

# --- Hedera / x402 (step 10, api/ only) ---------------------------------------
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
# HCS topic the API writes exposure-disclosure receipts to. Created once at step 10.
HCS_TOPIC_ID=
# Where x402 settlement is received, and the key the monitor agent pays FROM.
X402_RECEIVER=
X402_PAYER_KEY=

# --- RPC overrides (optional) -------------------------------------------------
# Per-chain override, keyed by chain id. Falls back to the public endpoint list
# in src/chains.js. Set these if you have paid endpoints; the public ones are
# rate-limited and several reject JSON-RPC batching.
NONCE0_RPC_1=
NONCE0_RPC_8453=
NONCE0_RPC_42161=
NONCE0_RPC_11155111=

# --- Project X ---------------------------------------------------------------
# Public/browser configuration has no secret values.
PROJECT_X_ARC_CHAIN_ID=5042002
PROJECT_X_POOL_ADDRESS=
PROJECT_X_PQ_REGISTRY_ADDRESS=
PROJECT_X_GRAPH_URL=
PROJECT_X_MESH_ENTRY_URL=

# Server-only. Never expose through browser bundles or frontend variables.
PROJECT_X_CRE_WORKFLOW_ID=
PROJECT_X_CRE_TEE_PUBLIC_KEY=
